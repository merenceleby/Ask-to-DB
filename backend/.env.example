# Copy this file to .env and fill in real values.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemma-4-26b-a4b-it

# --- Database provider: "supabase" or "cloudsql" ---
DB_PROVIDER=supabase

# Supabase connection string (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxx.supabase.co:5432/postgres

# Cloud SQL (only needed if DB_PROVIDER=cloudsql)
CLOUDSQL_INSTANCE_CONNECTION_NAME=my-project:us-central1:my-instance
CLOUDSQL_DB=postgres
CLOUDSQL_USER=postgres
CLOUDSQL_PASSWORD=

# --- Safety limits ---
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=200

# --- Rate limiting ---
RATE_LIMIT=20/minute

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ALLOW_ORIGINS=http://localhost:5173
